/*This is an SQL DATABASE MANAGEMENT SYSTEM DESIGN PROJECT
for SMART CITY PARKING MANAGEMENT SYSTEM

DATABASE CREATION*/

-- CREATE DATABASE
CREATE DATABASE SmartCityParkingManagementSystem
GO

USE SmartCityParkingManagementSystem
GO

--CREATE CUSTOMER TABLE
CREATE TABLE Customer (
CustomerID INT IDENTITY(1,1) PRIMARY KEY,
FirstName NVARCHAR(100) NOT NULL,
LastName NVARCHAR(100) NOT NULL,
Email NVARCHAR(100) NOT NULL UNIQUE,
PhoneNumber NVARCHAR(20) NULL UNIQUE,
CreatedAT DATETIME NOT NULL DEFAULT GETDATE(),
UpdatedAT DATETIME NOT NULL DEFAULT GETDATE()
);

SELECT *FROM Customer


--CREATE VEHICLE TABLE
CREATE TABLE Vehicle (
VehicleID INT IDENTITY(1,1) PRIMARY KEY,
CustomerID INT NOT NULL,
LicensePlate NVARCHAR(20) NOT NULL UNIQUE,
VehicleMake NVARCHAR(100) NULL,
VehicleModel NVARCHAR(100) NULL,
VehicleColor NVARCHAR(20) NOT NULL,
VehicleType NVARCHAR(100) NOT NULL,
CreatedAT DATETIME NOT NULL DEFAULT GETDATE(),
UpdatedAT DATETIME NOT NULL DEFAULT GETDATE()

CONSTRAINT FK_Vehicle_Customer
FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID)
);

SELECT *FROM Vehicle

--CREATE PARKINGLOT TABLE
CREATE TABLE ParkingLot (
ParkingLotID INT IDENTITY(1,1) PRIMARY KEY,
LotName NVARCHAR(100) NOT NULL UNIQUE,
Address NVARCHAR(300) NOT NULL,
CityZone NVARCHAR(300) NOT NULL,
TotalSpaces INT NOT NULL CHECK (TotalSpaces>0),
HourlyRate DECIMAL(6,2) NOT NULL,
CreatedAT DATETIME NOT NULL DEFAULT GETDATE(),
UpdatedAT DATETIME NOT NULL DEFAULT GETDATE()
);

SELECT *FROM ParkingLot

--CREATE PARKINGSPACE TABLE
CREATE TABLE ParkingSpace (
ParkingSpaceID INT IDENTITY (1,1) PRIMARY KEY,
ParkingLotID INT NOT NULL,
SpaceNumber NVARCHAR(10) NOT NULL,
FloorLevel NVARCHAR(20) NULL,
SpaceType NVARCHAR(30) NOT NULL
	CHECK (SpaceType IN ('Regular','Compact','Handicap','Electric Vehicle')),
IsOccupied BIT NOT NULL DEFAULT 1,
CreatedAT DATETIME NOT NULL DEFAULT GETDATE(),
UpdatedAT DATETIME NOT NULL DEFAULT GETDATE(),

CONSTRAINT FK_ParkingSpace_ParkingLot
FOREIGN KEY (ParkingLotID) REFERENCES ParkingLot(ParkingLotID)
);

SELECT *FROM ParkingSpace

--CREATE PARKINGSESSION TABLE
CREATE TABLE ParkingSession (
ParkingSessionID INT IDENTITY(1,1) PRIMARY KEY,
CustomerID INT NOT NULL,
VehicleID INT NOT NULL,
ParkingSpaceID INT NOT NULL,
EntryTime DATETIME NOT NULL,
Exittime DATETIME NOT NULL,
TotalHours TIME NOT NULL,
TotalFee DECIMAL(8,2) NOT NULL,
PaymentStatus NVARCHAR(20) DEFAULT 'Pending'
	CHECK (PaymentStatus IN ('Pending','Paid','Unpaid')),
CreatedAT DATETIME NOT NULL DEFAULT GETDATE(),
UpdatedAT DATETIME NOT NULL DEFAULT GETDATE(),

CONSTRAINT FK_ParkingSession_Customer
FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID),

CONSTRAINT FK_ParkingSession_Vehicle
FOREIGN KEY (VehicleID) REFERENCES Vehicle(VehicleID),

CONSTRAINT FK_ParkingSession_ParkingSpace
FOREIGN KEY (ParkingSpaceID) REFERENCES ParkingSpace(ParkingSpaceID)
);

SELECT *FROM ParkingSession

--CREATE MEMBERSHIPPLAN TABLE
CREATE TABLE MembershipPlan (
MembershipPlanID INT IDENTITY(1,1) PRIMARY KEY,
CustomerID INT NOT NULL,
MembershipPlanName NVARCHAR(50) NOT NULL,
Price DECIMAL(8,2) NOT NULL,
DurationMonth INT NOT NULL,
DiscountRate DECIMAL(4,2)
	CHECK (DiscountRate BETWEEN 0 AND 10),
CreatedAT DATETIME NOT NULL DEFAULT GETDATE(),
UpdatedAT DATETIME NOT NULL DEFAULT GETDATE(),

CONSTRAINT FK_MembershipPlan_Customer
FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID)
);

SELECT *FROM MembershipPlan

--CREATE PAYMENT TABLE
CREATE TABLE Payment (
PaymentID INT IDENTITY(1,1) PRIMARY KEY,
ParkingSessionID INT NOT NULL,
PaymentDate DATETIME NOT NULL DEFAULT GETDATE(),
Amount DECIMAL(8,2) NOT NULL,
PaymentMethod NVARCHAR(30) NOT NULL
	CHECK (PaymentMethod IN('Cash','Transfer')),
PaymentStatus NVARCHAR(30)
	CHECK (PaymentStatus IN ('Success','Failed')),
CreatedAT DATETIME NOT NULL DEFAULT GETDATE(),
UpdatedAT DATETIME NOT NULL DEFAULT GETDATE(),

CONSTRAINT FK_Payment_ParkingSession
FOREIGN KEY (ParkingSessionID) REFERENCES ParkingSession(ParkingSessionID)
);

SELECT *FROM Payment

--CREATE CUSTOMERMEMBERSHIP TABLE
CREATE TABLE CustomerMembership (
CustomerMembershipID INT IDENTITY(1,1) PRIMARY KEY,
CustomerID INT NOT NULL,
MembershipPlanID INT NOT NULL,
StartDate DATE NOT NULL,
EndDate DATE NOT NULL,
IsActive BIT NOT NULL DEFAULT 1,
CreatedAT DATETIME NOT NULL DEFAULT GETDATE(),
UpdatedAT DATETIME NOT NULL DEFAULT GETDATE(),

CONSTRAINT FK_CustomerMembership_Customer
FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID),

CONSTRAINT FK_CustomerMembership_MembershipPlan
FOREIGN KEY (MembershipPlanID) REFERENCES MembershipPlan(MembershipPlanID)
);

SELECT *FROM CustomerMembership
